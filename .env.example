# Environment Configuration Example
# Copy this file to .env and configure your keys if using external LLMs

# External LLM API Keys (Optional - Autonomous Demo Mode functions without keys)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Mode configuration: set to 'true' to use external API, or 'false' for reliable offline Demo Mode
LLM_API_ENABLED=false

# Server Configuration
PORT=8000
HOST=0.0.0.0
